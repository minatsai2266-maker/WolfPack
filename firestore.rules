rules_version = '2';
// 把下面的 OWNER@example.com 換成最高管理員的 Email（全部小寫）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isOwner()  { return signedIn() && myEmail() == 'OWNER@example.com'; }
    function isAdmin()  { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()))); }

    // 管理員名單：登入的人可以查（用來判斷自己是不是管理員），只有最高管理員能改
    match /admins/{email} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // 標裝限制、人員名單、敵人警誡名單
    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 公告、報名項目
    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 報名：任何人都能報名（不用登入），只有管理員能刪
    match /signups/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['itemId','name','note','createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                    && request.resource.data.note is string && request.resource.data.note.size() <= 200
                    && request.resource.data.createdAt is number
                    && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId));
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
